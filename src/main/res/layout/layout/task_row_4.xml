<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:minHeight="64dp"
    android:background="#FFFFFF">

    <CheckBox
        android:id="@+id/checkTask4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#5146A8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/taskText4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:text="Preparar la presentación"
        android:textColor="#20243A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/checkTask4"
        app:layout_constraintEnd_toStartOf="@id/priority4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/taskTime4"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/taskTime4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="3dp"
        android:text="Mañana · 12:00"
        android:textColor="#778099"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/checkTask4"
        app:layout_constraintEnd_toStartOf="@id/priority4"
        app:layout_constraintTop_toBottomOf="@id/taskText4"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/priority4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="#E8DFFF"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="Alta"
        android:textColor="#6038B8"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
